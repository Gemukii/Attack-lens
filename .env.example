ATTACKLENS_DEFAULT_TARGET=host.docker.internal
ATTACKLENS_CORS_ORIGINS=http://localhost:3000

# Protects the API. The dashboard adds it on the server side, the browser never sees it.
# The host agent reads the same variable. Leave empty to keep the API open on localhost.
ATTACKLENS_API_KEY=

# Protects the dashboard itself. Required as soon as it is reachable beyond this machine.
ATTACKLENS_DASHBOARD_PASSWORD=

# Optional comma-separated host/IP allowlist for scan targets.
ATTACKLENS_ALLOWED_TARGETS=

# Send package names and versions to the public OSV database (https://osv.dev).
ATTACKLENS_ENABLE_OSV=false

# Discord or Slack webhook notified when a new finding appears. Findings are sent to it.
ATTACKLENS_ALERT_WEBHOOK_URL=
# Lowest severity worth an alert: info, low, medium, high, or critical.
ATTACKLENS_ALERT_MIN_SEVERITY=low
# Report an agent that has been quiet for this long.
ATTACKLENS_AGENT_SILENCE_SECONDS=300

# Delete scans older than this, always keeping the latest scan of each machine.
ATTACKLENS_RETENTION_DAYS=365

# Refuse any scan outside the scope of an active engagement.
ATTACKLENS_AUDIT_MODE=false
